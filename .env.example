# ============================================================
# FDS Command Hub — environment contract
# Copy to .env for local dev:  cp .env.example .env
# In production, set these in Vercel → Project → Settings →
# Environment Variables. NEVER commit real secrets.
# ============================================================

# ---- Stage 0: Database (required) --------------------------
# Local dev default is a SQLite file (zero setup). For production
# use Neon or Vercel Postgres and ALSO flip `provider` to
# "postgresql" in prisma/schema.prisma (see README → Database).
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ---- Stage 3: Shopify -----------------------------------------
# Domain is the store's *.myshopify.com host (already known for FDS).
# Credentials: Dev Dashboard (dev.shopify.com) → "FDS Command Hub"
# app → Settings → Client ID + Client secret. The app exchanges them
# for 24h Admin tokens automatically (client credentials grant).
# App scopes: read_products, read_orders, read_customers.
SHOPIFY_STORE_DOMAIN="gthv54-e1.myshopify.com"
# SHOPIFY_CLIENT_ID=""
# SHOPIFY_CLIENT_SECRET=""
# Legacy alternative (admin-created custom apps only):
# SHOPIFY_ADMIN_TOKEN="shpat_..."

# ---- Stage 4: Comms (human supplies) ------------------------
# Discord: create an app + bot at discord.com/developers.
# DISCORD_BOT_TOKEN=""
# DISCORD_WEBHOOK_URL=""            # ALSO powers Ad Budget Watch phone
#                                   alerts: create a webhook on any
#                                   Discord channel (Server Settings →
#                                   Integrations → Webhooks), paste the
#                                   URL here, install Discord mobile, and
#                                   low-balance reminders push to your phone.
# DISCORD_CHANNEL_IDS=""            # comma-separated channel IDs
# DISCORD_GUILD_ID=""               # optional; inferred when the bot is in one
#                                   # server or from DISCORD_CHANNEL_IDS
# DISCORD_FOLLOWUPS_WEBHOOK_URL=""  # fallback when using a dedicated
#                                   # #follow-ups webhook instead of the bot

# Google OAuth client (Gmail + Calendar scopes), from Google
# Cloud Console → APIs & Services → Credentials.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ---- Quo (business phone) — docs/quo-crm-integration.md -----
# Calls, recordings, transcripts and AI summaries sync onto the
# matching lead. Calls are PLACED in the Quo desktop app (its API
# cannot start a call); the CRM records what happened.
#
# Master switch. Everything below is inert until this is "true" —
# and setting it back to "false" is the rollback. It stops webhook
# processing, sync, AI extraction and incoming-call alerts without
# deleting a single stored record.
# QUO_INTEGRATION_ENABLED="false"
#
# Workspace API key: Quo → workspace settings → API (owner/admin
# only). NOTE: Quo sends this raw — there is no "Bearer " prefix.
# QUO_API_KEY=""
#
# Standard-Webhooks signing secret, shown ONCE when the webhook is
# created (or rotated). Register the webhook from /integrations/quo
# pointing at https://<your-host>/api/integrations/quo/webhooks,
# then paste the whsec_… value here. Never stored in the database.
# QUO_WEBHOOK_SECRET=""
#
# Optional. Host only; the client adds /v1 or the versioned path.
# QUO_API_BASE_URL="https://api.quo.com"
# Restrict which Quo numbers sync (comma-separated PN… ids).
# Empty = every number in the workspace.
# QUO_PHONE_NUMBER_IDS=""
# QUO_DEFAULT_PHONE_NUMBER_ID=""
# Region used only for parsing numbers typed into the CRM; Quo
# itself always sends E.164.
# QUO_DEFAULT_REGION="US"
# Recordings stay Quo-hosted and stream through a permission-checked
# proxy. "provider" is the only supported value — copying to object
# storage needs a blob store this project doesn't have yet.
# QUO_RECORDING_STORAGE_MODE="provider"
# Our own transcript → structured-data pass. On by default; turn it
# off to keep call sync while disabling the AI.
# QUO_AI_EXTRACTION_ENABLED="true"

# ---- Stage 5: Agent harness (human supplies) ----------------
# ANTHROPIC_API_KEY=""              # Claude Code harness
# OPENAI_API_KEY=""                 # Codex harness

# ---- HQ engine: agent API access -----------------------------
# Bearer token the Claude agent (PM / workers) uses to read/write
# hub data through /api/*. Generate any long random string, e.g.:
#   openssl rand -hex 32
# AGENT_API_KEY=""

# ---- Ad Budget Watch: daily cron (Vercel) --------------------
# The runway sweep runs daily via Vercel Cron (see vercel.json). Set a
# secret so only Vercel can trigger it; Vercel sends it automatically as
# `Authorization: Bearer <CRON_SECRET>`. Generate: openssl rand -hex 32
# CRON_SECRET=""

# ---- Team access gate (production; src/proxy.ts) --------------
# Shared credentials for the deployed HQ. Unset = gate off (local
# dev). The team signs in once per browser via the native prompt.
# TEAM_USER="fds"
# TEAM_PASSWORD=""

# ---- Stage 7: Auth (human supplies) -------------------------
# Generate with: npx auth secret
# AUTH_SECRET=""
