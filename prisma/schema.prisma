// FDS Command Hub schema.
//
// Provider note: local development runs on SQLite (zero setup). For
// production, switch `provider` to "postgresql" and set DATABASE_URL to
// your Neon/Vercel Postgres connection string, then run
// `npx prisma migrate dev`. Models avoid SQLite-only or Postgres-only
// features so the switch is mechanical. See README → "Database".
//
// MIGRATION POLICY (docs/FDS_HQ_Decisions.md): migrations against the
// CrmRecord data table are ADDITIVE ONLY — the physical table keeps its
// original "Supplier" name via @@map, and generated SQL is inspected
// before applying (no DROP/rebuild of the data table). This protects
// the 100-supplier dataset (D1).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Stage 0 health check — proves the migration pipeline works.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  note      String   @default("ok")
  checkedAt DateTime @default(now())
}

// ---------------- CRM: the unified Record spine ----------------
//
// One table, two record types (docs/FDS_CRM_Data_Model.md + Decisions):
//   type = "supplier" — outbound dealer recruiting
//   type = "lead"     — inbound buyers
//
// Status ladders live in src/lib/domain.ts (kept as String for
// cross-database portability):
//   supplier: SOURCED | QUALIFIED | CONTACTED | REPLIED |
//             IN_CONVERSATION | CALL_SCHEDULED | NEGOTIATING |
//             AUTHORIZED | ON_HOLD | DECLINED
//   lead:     NEW | CONTACTED | ENGAGED | QUOTE_REQUESTED |
//             QUOTE_SENT | CALL_NEGOTIATION | WON | NURTURE | LOST
//
// NOTE: the DB-level default on `status` is the legacy value and is
// deliberately NOT changed (changing a SQLite column default forces a
// destructive table rebuild). The app layer always sets status
// explicitly on create (src/lib/validation.ts).
model CrmRecord {
  id       String  @id @default(cuid())
  recordId String? @unique // human ID: FDS-SUP-#### / FDS-LEAD-####
  type     String  @default("supplier") // supplier | lead
  name     String
  company  String?

  // Supplier sheet fields (kept additive — real FDS data lives here)
  niche        String?
  cluster      String  @default("Other")
  bestSeller   String?
  rank         String? // Gold | Silver | Bronze | null (unranked)
  websiteUrl   String?
  dealerAppUrl String?
  mainContact  String?
  email        String?
  phone        String?

  status String @default("NOT_CONTACTED") @map("stage") // see NOTE above

  // Spine (CRM Data Model §2)
  owner           String  @default("unassigned") // claude | you | unassigned
  priority        String? // hot | warm | cold
  contextSummary  String?
  tags            String  @default("[]") // JSON array of "dimension:value" strings
  linkedThread    String? // Gmail thread ID(s)
  linkedShopifyId String? // Shopify customer/order ID

  // Supplier-only (§4, MVP subset)
  mapPolicy           String?
  dropship            Boolean?
  freightModel        String?
  leadTime            String?
  warranty            String?
  productCategories   String  @default("[]") // JSON array; maps to Collection Map
  dealerProgram       String? // dropship | stocking | none | unknown
  mediaPermission     String? // granted | requested | none
  authorizationStatus String? // none | pending | authorized

  // Lead-only (§5, MVP subset)
  productInterest String?
  intent          String? // browsing | comparing | ready-to-buy
  quoteAmount     Float?

  lastContactDate DateTime?
  nextAction      String?
  nextActionDate  DateTime?
  notes           String?
  source          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions Interaction[]
  approvals    Approval[]
  callSessions CallSession[]

  @@index([status])
  @@index([cluster])
  @@index([nextActionDate])
  @@index([type])
  @@index([owner])
  @@map("Supplier")
}

// The activity_log of the spec (CRM Data Model §2) — every email,
// call, note, and system event on a record, with who logged it.
model Interaction {
  id       String    @id @default(cuid())
  recordId String    @map("supplierId")
  record   CrmRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  date     DateTime  @default(now())
  type     String // email | call | form | note | status | system
  body     String
  actor    String    @default("you") // you | claude | system

  @@index([recordId, date])
}

// ---------------- The gate (Blueprint §3 Layer 4) ----------------
//
// Every outbound / irreversible action the agent wants to take lands
// here as a draft and waits for one-tap human approval. Nothing fires
// autonomously (D7, autonomy notch 0).
model Approval {
  id           String     @id @default(cuid())
  kind         String // outbound_email | publish_product | price_quote | discount | other
  title        String
  recordId     String?
  record       CrmRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  draftSubject String?
  draftBody    String
  reasoning    String? // why Claude queued this (full context, shown on the card)
  status       String     @default("pending") // pending | approved | rejected | snoozed | executed
  decisionNote String?
  snoozedUntil DateTime?
  createdBy    String     @default("claude")
  decidedAt    DateTime?
  executedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
}

// ---------------- Task queue (Blueprint §3 Layer 5) ----------------
//
// Work assigned in plain language. The PM reads `queued`, plans, runs,
// and writes results back. `suggested` = the PM proposing work for
// Pablo to approve into the queue.
model HqTask {
  id          String    @id @default(cuid())
  title       String
  detail      String?
  status      String    @default("queued") // suggested | queued | running | done | cancelled
  assignee    String    @default("claude") // claude | you
  origin      String    @default("you") // you | claude
  result      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
}

// ---------------- Live Sales Cockpit ----------------
//
// One row per phone call worked in the cockpit. `data` holds the
// call-time working state (product, verifications, quote math…) and
// `notes` the structured note stream (confirmed | suggestion | note |
// objection). Durable outcomes are written to the CrmRecord + an
// Interaction when the call ends; the session row keeps the full
// audit trail of what was on screen.
model CallSession {
  id          String    @id @default(cuid())
  recordId    String
  record      CrmRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  outcome     String? // advancing | quote_requested | follow_up | won | nurture | lost
  notes       String    @default("[]") // JSON: [{at, kind, text}]
  data        String    @default("{}") // JSON: CockpitData (src/lib/cockpit.ts)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([recordId, startedAt])
}

// ---------------- AI Chat (the live agent surface) ----------------
//
// Claude-style working sessions with the in-app agent. Each session is
// a conversation; tool activity is stored as a display log on the
// assistant message (the agent re-reads live data each turn, so tool
// exchanges are not replayed as model context).
model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  toolLog   String      @default("[]") // JSON array of {tool, summary} for the UI
  model     String? // which model produced an assistant turn
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// ---------------- Agent messages (the thin Chat surface) ----------------
//
// Morning briefs, pings, and run logs from the PM land here; Pablo's
// replies are stored too (the PM reads them on its next run). True
// two-way chat stays in Claude itself for now (Decisions log).
model AgentMessage {
  id        String   @id @default(cuid())
  role      String   @default("claude") // claude | you
  kind      String   @default("log") // brief | ping | log | chat
  title     String?
  body      String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

// ---------------- Clutch Timeline ----------------
//
// The "clutch" log — a running timeline of every batch of work we knock
// down, plotted by the day it happened. The timeline opens ~3 months
// back (the "Started E10" origin event) and runs forward to today; each
// clutch is a dated marker with a title and optional notes. Purely a
// human-curated journal surface (no agent writes), so it stays outside
// the CRM record spine.
model Clutch {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  date      DateTime // the day this clutch landed (what the timeline plots)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ---------------- Ad Budget Watch ----------------
//
// Keeps ad-account balances accountable so the card never declines.
// One row per spending account (Google Ads today; platform is free
// text so Meta etc. fit later). Balance is derived-but-stored: every
// deposit and adjustment is an AdLedgerEntry, and `balance` is the
// running total the app keeps in sync on each write (single source of
// truth for the runout math).
//
// Runout projection (app layer, src/lib/ad-budget.ts):
//   daysLeft = balance / dailyBudget
//   runoutDate = today + daysLeft
// A reminder fires when the remaining balance drops to/under
// `thresholdPct` of a full day-budget buffer — i.e. when we're within
// `thresholdDays` of running dry — pushed to Discord by the daily cron
// (src/app/api/cron/check-balances). AlertLog dedupes so we nudge once
// per crossing, not every run.
model AdAccount {
  id           String  @id @default(cuid())
  name         String
  platform     String  @default("Google Ads")
  externalId   String? // the account's ID in the platform (CID etc.)
  currency     String  @default("USD")
  balance      Float   @default(0) // running balance, kept in sync with the ledger
  dailyBudget  Float   @default(0) // spend per day used for the runout projection
  thresholdDays Int    @default(3) // remind when ≤ this many days of runway remain
  active       Boolean @default(true)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger AdLedgerEntry[]
  alerts AlertLog[]

  @@index([active])
}

// Every money event on an account — deposits (top-ups) and manual
// balance corrections (reconcile to what the platform actually shows).
// `delta` is signed: +100 top-up, -12.50 correction. `balanceAfter`
// snapshots the running balance so the ledger reads as a statement.
model AdLedgerEntry {
  id           String    @id @default(cuid())
  accountId    String
  account      AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         String // deposit | adjustment
  delta        Float // signed amount applied to the balance
  balanceAfter Float // running balance immediately after this entry
  note         String?
  occurredAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([accountId, occurredAt])
}

// Notification dedupe + audit. One row per alert actually sent, so the
// cron nudges once per low-balance crossing (keyed on account + the
// severity band) and the UI can show "last alerted".
model AlertLog {
  id        String    @id @default(cuid())
  accountId String?
  account   AdAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String // low_balance | runout | test
  severity  String    @default("warn") // warn | critical
  channel   String    @default("discord") // discord | none
  title     String
  body      String
  delivered Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([accountId, kind, createdAt])
}

// ---------------- Password Control ----------------

// Credential vault. The secret is NEVER stored in the clear: `secret`
// holds an AES-256-GCM payload (see src/lib/secret-box.ts) sealed with
// CREDENTIAL_KEY, which lives only in the environment. A database dump
// on its own yields nothing readable.
//
// Everything except the secret is plain, so the list can render — the
// operator sees what an account is and who it's for without unsealing
// anything.
model Credential {
  id        String   @id @default(cuid())
  service   String // "Shopify", "Royal Mail", ...
  label     String? // which account, when there are several
  username  String?
  secret    String // sealed blob, never plaintext
  url       String?
  category  String   @default("Other")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reveals CredentialReveal[]

  @@index([service])
  @@index([category])
}

// One row per unseal. The point of a vault is knowing when something
// came out of it.
model CredentialReveal {
  id           String     @id @default(cuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  actor        String     @default("you")
  createdAt    DateTime   @default(now())

  @@index([credentialId, createdAt])
}

// ---------------- Self-modification panel ----------------

// One row per coding-agent run dispatched from /self-modify.
//
// The app never runs the agent itself (serverless: no checkout, no git).
// It triggers a GitHub Actions workflow, which does the work on a fresh
// branch and opens a PR; this table is the hub's memory of that run so
// history survives the panel being closed (spec Step 4.5).
//
// `status` mirrors the workflow: queued -> running -> succeeded|failed,
// plus `applied` once a human has merged the PR. Nothing here is ever
// written speculatively — a row only advances when GitHub says so.
model AgentRun {
  id     String @id @default(cuid())
  prompt String
  status String @default("queued")
  actor  String @default("you")

  // GitHub side of the run. Null until the workflow reports back.
  branch        String?
  workflowRunId String?
  runUrl        String?
  prNumber      Int?
  prUrl         String?

  // Review payload: the diff the human approves (or the failure reason).
  diff         String?
  filesChanged Int?
  additions    Int?
  deletions    Int?
  error        String?

  // Set only by an explicit "Apply & deploy" — never automatically.
  appliedAt DateTime?
  appliedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}
