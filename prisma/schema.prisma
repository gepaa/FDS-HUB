// FDS Command Hub schema.
//
// Provider note: local development runs on SQLite (zero setup). For
// production, switch `provider` to "postgresql" and set DATABASE_URL to
// your Neon/Vercel Postgres connection string, then run
// `npx prisma migrate dev`. Models avoid SQLite-only or Postgres-only
// features so the switch is mechanical. See README → "Database".
//
// MIGRATION POLICY (docs/FDS_HQ_Decisions.md): migrations against the
// CrmRecord data table are ADDITIVE ONLY — the physical table keeps its
// original "Supplier" name via @@map, and generated SQL is inspected
// before applying (no DROP/rebuild of the data table). This protects
// the 100-supplier dataset (D1).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Stage 0 health check — proves the migration pipeline works.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  note      String   @default("ok")
  checkedAt DateTime @default(now())
}

// ---------------- CRM: the unified Record spine ----------------
//
// One table, two record types (docs/FDS_CRM_Data_Model.md + Decisions):
//   type = "supplier" — outbound dealer recruiting
//   type = "lead"     — inbound buyers
//
// Status ladders live in src/lib/domain.ts (kept as String for
// cross-database portability):
//   supplier: SOURCED | QUALIFIED | CONTACTED | REPLIED |
//             IN_CONVERSATION | CALL_SCHEDULED | NEGOTIATING |
//             AUTHORIZED | ON_HOLD | DECLINED
//   lead:     NEW | CONTACTED | ENGAGED | QUOTE_REQUESTED |
//             QUOTE_SENT | CALL_NEGOTIATION | WON | NURTURE | LOST
//
// NOTE: the DB-level default on `status` is the legacy value and is
// deliberately NOT changed (changing a SQLite column default forces a
// destructive table rebuild). The app layer always sets status
// explicitly on create (src/lib/validation.ts).
model CrmRecord {
  id       String  @id @default(cuid())
  recordId String? @unique // human ID: FDS-SUP-#### / FDS-LEAD-####
  type     String  @default("supplier") // supplier | lead
  name     String
  company  String?

  // Supplier sheet fields (kept additive — real FDS data lives here)
  niche        String?
  cluster      String  @default("Other")
  bestSeller   String?
  rank         String? // Gold | Silver | Bronze | null (unranked)
  websiteUrl   String?
  dealerAppUrl String?
  mainContact  String?
  email        String?
  phone        String?
  // Normalised E.164 form of `phone`, written by src/lib/quo/phone.ts.
  // This — never the display value — is what inbound Quo calls match on.
  phoneE164    String?

  status String @default("NOT_CONTACTED") @map("stage") // see NOTE above

  // Spine (CRM Data Model §2)
  owner           String  @default("unassigned") // claude | you | unassigned
  priority        String? // hot | warm | cold
  contextSummary  String?
  tags            String  @default("[]") // JSON array of "dimension:value" strings
  linkedThread    String? // Gmail thread ID(s)
  linkedShopifyId String? // Shopify customer/order ID

  // Supplier-only (§4, MVP subset)
  supplierOwnerId         String?
  supplierOwner           TeamMember? @relation(fields: [supplierOwnerId], references: [id], onDelete: SetNull)
  dealerApplicationSigned Boolean     @default(false)
  initialEmailSent        Boolean     @default(false)
  supplierContacts        String      @default("[]") // JSON array of contact people
  followUpReminderSentFor DateTime? // exact nextActionDate already pushed to Discord
  mapPolicy               String?
  dropship                Boolean?
  freightModel            String?
  leadTime                String?
  warranty                String?
  productCategories       String      @default("[]") // JSON array; maps to Collection Map
  dealerProgram           String? // dropship | stocking | none | unknown
  mediaPermission         String? // granted | requested | none
  authorizationStatus     String? // none | pending | authorized

  // Lead-only (§5, MVP subset)
  productInterest String?
  intent          String? // browsing | comparing | ready-to-buy
  quoteAmount     Float?

  lastContactDate DateTime?
  nextAction      String?
  nextActionDate  DateTime?
  notes           String?
  source          String?

  // Set when a record was created from an inbound call and still has
  // nothing but a phone number — the leads dashboard flags these for a
  // human to fill in (§7 "requires enrichment").
  needsEnrichment Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions    Interaction[]
  approvals       Approval[]
  callSessions    CallSession[]
  commsActivities CommsActivity[]
  quoContact      QuoContactLink?
  tasks           HqTask[]

  @@index([status])
  @@index([cluster])
  @@index([nextActionDate])
  @@index([type])
  @@index([owner])
  @@index([supplierOwnerId])
  @@index([phoneE164])
  @@map("Supplier")
}

// The activity_log of the spec (CRM Data Model §2) — every email,
// call, note, and system event on a record, with who logged it.
model Interaction {
  id       String    @id @default(cuid())
  recordId String    @map("supplierId")
  record   CrmRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  date     DateTime  @default(now())
  type     String // email | call | form | note | status | system
  body     String
  actor    String    @default("you") // you | claude | system

  @@index([recordId, date])
}

// ---------------- The gate (Blueprint §3 Layer 4) ----------------
//
// Every outbound / irreversible action the agent wants to take lands
// here as a draft and waits for one-tap human approval. Nothing fires
// autonomously (D7, autonomy notch 0).
model Approval {
  id           String     @id @default(cuid())
  kind         String // outbound_email | publish_product | price_quote | discount | other
  title        String
  recordId     String?
  record       CrmRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  draftSubject String?
  draftBody    String
  reasoning    String? // why Claude queued this (full context, shown on the card)
  status       String     @default("pending") // pending | approved | rejected | snoozed | executed
  decisionNote String?
  snoozedUntil DateTime?
  createdBy    String     @default("claude")
  decidedAt    DateTime?
  executedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
}

// ---------------- Task queue (Blueprint §3 Layer 5) ----------------
//
// Work assigned in plain language. The PM reads `queued`, plans, runs,
// and writes results back. `suggested` = the PM proposing work for
// Pablo to approve into the queue.
// A follow-up proposed from a call lands here as `suggested` — the
// existing "PM proposes, human accepts" status. Nothing generated from a
// transcript is ever queued automatically, and nothing here sends
// anything outward (outbound still goes through Approval).
model HqTask {
  id          String    @id @default(cuid())
  title       String
  detail      String?
  status      String    @default("queued") // suggested | queued | running | done | cancelled
  assignee    String    @default("claude") // claude | you
  origin      String    @default("you") // you | claude
  result      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Follow-up context (Quo call integration). All optional so every
  // existing task row stays valid.
  recordId       String?
  record         CrmRecord?     @relation(fields: [recordId], references: [id], onDelete: SetNull)
  activityId     String?
  activity       CommsActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  priority       String? // hot | warm | cold
  source         String         @default("human") // human | quo_call | agent
  aiGenerated    Boolean        @default(false)
  humanConfirmed Boolean        @default(false)

  // Shared to-do board. `assignee` (claude | you) stays the agent-facing
  // field so every existing row and the agent tools keep working;
  // `assigneeId` is the human seat that owns it, null when it is the
  // agent's or nobody's. `pinned` is the one manual override on an
  // otherwise automatic sort. `aiBrief` is the model's expansion of a
  // one-line note into a real task — advisory text, never an action.
  assigneeId  String?
  assignedTo  TeamMember?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  pinned      Boolean          @default(false)
  aiBrief     String?
  aiBriefAt   DateTime?
  attachments TaskAttachment[]

  @@index([status, createdAt])
  @@index([recordId])
  @@index([activityId])
  @@index([dueDate])
  @@index([assigneeId])
}

// ---------------- To-do board: seats and attachments ----------------
//
// The human side of the board is three seats. They are rows, not an
// enum, so renaming a teammate is an edit in the UI rather than a
// migration + deploy. Seats are never deleted (a deleted seat would
// orphan its history); `active` hides one from the pickers instead.
model TeamMember {
  id            String   @id
  name          String
  initials      String
  color         String   @default("#8AB4F8")
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  discordUserId String? // numeric Discord user id for reminder mentions
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks           HqTask[]
  supplierRecords CrmRecord[]

  @@index([sortOrder])
}

// A doc or link pinned to a to-do.
//
// Files are stored inline in the row rather than in object storage: the
// hub has no blob store configured, and the things that get attached
// here are quotes, specs and screenshots. MAX_ATTACHMENT_BYTES in
// src/lib/tasks/attachments.ts caps it well under the 4.5 MB serverless
// request limit — anything bigger belongs in Drive with a link here.
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      HqTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String // link | file
  label     String
  url       String?
  mimeType  String?
  sizeBytes Int?
  data      Bytes?
  addedBy   String   @default("you")
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ---------------- Live Sales Cockpit ----------------
//
// One row per phone call worked in the cockpit. `data` holds the
// call-time working state (product, verifications, quote math…) and
// `notes` the structured note stream (confirmed | suggestion | note |
// objection). Durable outcomes are written to the CrmRecord + an
// Interaction when the call ends; the session row keeps the full
// audit trail of what was on screen.
model CallSession {
  id          String    @id @default(cuid())
  recordId    String
  record      CrmRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  outcome     String? // advancing | quote_requested | follow_up | won | nurture | lost
  notes       String    @default("[]") // JSON: [{at, kind, text}]
  data        String    @default("{}") // JSON: CockpitData (src/lib/cockpit.ts)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([recordId, startedAt])
}

// ---------------- AI Chat (the live agent surface) ----------------
//
// Claude-style working sessions with the in-app agent. Each session is
// a conversation; tool activity is stored as a display log on the
// assistant message (the agent re-reads live data each turn, so tool
// exchanges are not replayed as model context).
model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  toolLog   String      @default("[]") // JSON array of {tool, summary} for the UI
  model     String? // which model produced an assistant turn
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// ---------------- Agent messages (the thin Chat surface) ----------------
//
// Morning briefs, pings, and run logs from the PM land here; Pablo's
// replies are stored too (the PM reads them on its next run). True
// two-way chat stays in Claude itself for now (Decisions log).
model AgentMessage {
  id        String   @id @default(cuid())
  role      String   @default("claude") // claude | you
  kind      String   @default("log") // brief | ping | log | chat
  title     String?
  body      String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

// ---------------- Clutch Timeline ----------------
//
// The "clutch" log — a running timeline of every batch of work we knock
// down, plotted by the day it happened. The timeline opens ~3 months
// back (the "Started E10" origin event) and runs forward to today; each
// clutch is a dated marker with a title and optional notes. Purely a
// human-curated journal surface (no agent writes), so it stays outside
// the CRM record spine.
model Clutch {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  date      DateTime // the day this clutch landed (what the timeline plots)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ---------------- Ad Budget Watch ----------------
//
// Keeps ad-account balances accountable so the card never declines.
// One row per spending account (Google Ads today; platform is free
// text so Meta etc. fit later). Balance is derived-but-stored: every
// deposit and adjustment is an AdLedgerEntry, and `balance` is the
// running total the app keeps in sync on each write (single source of
// truth for the runout math).
//
// Runout projection (app layer, src/lib/ad-budget.ts):
//   daysLeft = balance / dailyBudget
//   runoutDate = today + daysLeft
// A reminder fires when the remaining balance drops to/under
// `thresholdPct` of a full day-budget buffer — i.e. when we're within
// `thresholdDays` of running dry — pushed to Discord by the daily cron
// (src/app/api/cron/check-balances). AlertLog dedupes so we nudge once
// per crossing, not every run.
model AdAccount {
  id            String  @id @default(cuid())
  name          String
  platform      String  @default("Google Ads")
  externalId    String? // the account's ID in the platform (CID etc.)
  currency      String  @default("USD")
  balance       Float   @default(0) // running balance, kept in sync with the ledger
  dailyBudget   Float   @default(0) // spend per day used for the runout projection
  thresholdDays Int     @default(3) // remind when ≤ this many days of runway remain
  active        Boolean @default(true)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger AdLedgerEntry[]
  alerts AlertLog[]

  @@index([active])
}

// Every money event on an account — deposits (top-ups) and manual
// balance corrections (reconcile to what the platform actually shows).
// `delta` is signed: +100 top-up, -12.50 correction. `balanceAfter`
// snapshots the running balance so the ledger reads as a statement.
model AdLedgerEntry {
  id           String    @id @default(cuid())
  accountId    String
  account      AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         String // deposit | adjustment
  delta        Float // signed amount applied to the balance
  balanceAfter Float // running balance immediately after this entry
  note         String?
  occurredAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([accountId, occurredAt])
}

// Notification dedupe + audit. One row per alert actually sent, so the
// cron nudges once per low-balance crossing (keyed on account + the
// severity band) and the UI can show "last alerted".
model AlertLog {
  id        String     @id @default(cuid())
  accountId String?
  account   AdAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String // low_balance | runout | test
  severity  String     @default("warn") // warn | critical
  channel   String     @default("discord") // discord | none
  title     String
  body      String
  delivered Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([accountId, kind, createdAt])
}

// ---------------- Password Control ----------------

// Credential vault. The secret is NEVER stored in the clear: `secret`
// holds an AES-256-GCM payload (see src/lib/secret-box.ts) sealed with
// CREDENTIAL_KEY, which lives only in the environment. A database dump
// on its own yields nothing readable.
//
// Everything except the secret is plain, so the list can render — the
// operator sees what an account is and who it's for without unsealing
// anything.
model Credential {
  id        String   @id @default(cuid())
  service   String // "Shopify", "Royal Mail", ...
  label     String? // which account, when there are several
  username  String?
  secret    String // sealed blob, never plaintext
  url       String?
  category  String   @default("Other")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reveals CredentialReveal[]

  @@index([service])
  @@index([category])
}

// One row per unseal. The point of a vault is knowing when something
// came out of it.
model CredentialReveal {
  id           String     @id @default(cuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  actor        String     @default("you")
  createdAt    DateTime   @default(now())

  @@index([credentialId, createdAt])
}

// ---------------- Self-modification panel ----------------

// One row per coding-agent run dispatched from /self-modify.
//
// The app never runs the agent itself (serverless: no checkout, no git).
// It triggers a GitHub Actions workflow, which does the work on a fresh
// branch and opens a PR; this table is the hub's memory of that run so
// history survives the panel being closed (spec Step 4.5).
//
// `status` mirrors the workflow: queued -> running -> succeeded|failed,
// plus `applied` once a human has merged the PR. Nothing here is ever
// written speculatively — a row only advances when GitHub says so.
model AgentRun {
  id     String @id @default(cuid())
  prompt String
  status String @default("queued")
  actor  String @default("you")

  // GitHub side of the run. Null until the workflow reports back.
  branch        String?
  workflowRunId String?
  runUrl        String?
  prNumber      Int?
  prUrl         String?

  // Review payload: the diff the human approves (or the failure reason).
  diff         String?
  filesChanged Int?
  additions    Int?
  deletions    Int?
  error        String?

  // Set only by an explicit "Apply & deploy" — never automatically.
  appliedAt DateTime?
  appliedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

// ---------------- Quo telephony integration ----------------
//
// Quo (formerly OpenPhone) is the business phone system. The CRM never
// carries call audio — Quo does — but it owns the *record* of every
// call: who called, what was said, and what we promised. See
// docs/quo-crm-integration.md.
//
// Deliberately provider-neutral naming: `provider` is a column, not an
// assumption, so a second telephony provider can land later without a
// rename. Nothing below is Quo-specific except the values we store.

// One row per call (and later, per message). This is the durable
// activity spine that the lead timeline renders from — the dashboard
// never calls Quo synchronously (§24).
model CommsActivity {
  id                 String @id @default(cuid())
  provider           String @default("quo")
  // Quo's activity id (`AC…`). Unique per provider — this pair is what
  // makes duplicate webhook delivery a no-op (§8).
  providerActivityId String

  recordId String?
  record   CrmRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  type      String @default("call") // call | message
  direction String // incoming | outgoing
  // Quo's own call status vocabulary, stored verbatim:
  // queued | initiated | ringing | in-progress | completed | busy |
  // failed | no-answer | canceled | missed | answered | forwarded |
  // abandoned
  status    String

  providerPhoneNumberId  String? // PN… — which of our numbers
  providerConversationId String? // CN…
  providerUserId         String? // US… — the Quo user on the call
  answeredByUserId       String? // US… — who actually picked up

  // The customer's number: display form plus the normalised value that
  // lead matching actually uses (§7).
  externalNumber     String?
  externalNumberE164 String?

  startedAt   DateTime?
  answeredAt  DateTime?
  completedAt DateTime?
  durationSec Int?

  missed    Boolean @default(false)
  voicemail Boolean @default(false)
  // Quo sets this to "ai-agent" when their AI answered instead of a
  // human; null for ordinary calls.
  aiHandled String?

  forwardedFrom String?
  forwardedTo   String?

  // Deep link back into Quo for this activity (from the webhook's
  // `links.quo`) — the honest handoff when someone wants the live app.
  providerLink String?

  // Null until a human has actually looked at the call — drives the
  // "unreviewed call" indicator on the dashboard.
  reviewedAt DateTime?
  reviewedBy String?

  // Last provider payload seen for this activity, for support/debugging.
  raw String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artifacts  CallArtifact[]
  extraction CallExtraction?
  tasks      HqTask[]

  @@unique([provider, providerActivityId])
  @@index([recordId, startedAt])
  @@index([externalNumberE164])
  @@index([completedAt])
  @@index([status])
  @@index([missed, completedAt])
}

// Recordings, transcripts and summaries hang off a call. A single call
// can have SEVERAL recording segments (hold/resume), so recordings are
// rows, not columns — keyed by segment so a redelivered webhook updates
// in place instead of duplicating or re-downloading (§10).
//
// `status` mirrors Quo's artifact vocabulary
// (absent | in-progress | completed | failed | deleted | …). A 200 with
// `in-progress` means "not ready yet" — it is NOT an error and must not
// burn a retry budget as if it were.
model CallArtifact {
  id         String        @id @default(cuid())
  activityId String
  activity   CommsActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  kind               String // recording | transcript | summary | voicemail
  segmentIndex       Int     @default(0)
  // Quo's own id for this artifact (`CR…` for recordings) when supplied.
  providerArtifactId String?

  status String @default("pending")

  // Recording facets
  durationSec Int?
  mimeType    String?
  providerUrl String? // Quo-hosted; no documented expiry — never trusted as permanent
  storageKey  String? // set only when QUO_RECORDING_STORAGE_MODE copies it to our storage
  startedAt   DateTime?

  // Transcript facets. `text` is the flattened searchable form; the
  // speaker-separated dialogue is preserved as JSON exactly as supplied.
  text     String?
  dialogue String? // JSON: [{content, start, end, identifier, userId}]

  // Summary facets. Quo returns these as ARRAYS of strings, not prose.
  // `nextSteps` stays empty on the Business plan (Scale-only feature).
  bullets   String? // JSON: string[]
  nextSteps String? // JSON: string[]

  fetchedAt         DateTime?
  error             String?
  // Set by the retention policy; a sweep deletes content past this date.
  retentionDeleteAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityId, kind, segmentIndex])
  @@index([activityId, kind])
  @@index([providerArtifactId])
  @@index([retentionDeleteAt])
}

// Our own structured read of the call — separate from Quo's output so
// the provider's original is never overwritten (§11). `data` is the
// validated extraction object; `crmNote` is the human-editable summary
// generated from it.
model CallExtraction {
  id         String        @id @default(cuid())
  activityId String        @unique
  activity   CommsActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  status String  @default("pending") // pending | completed | failed | skipped
  model  String?
  data   String  @default("{}") // JSON, validated against src/lib/quo/extraction-schema.ts

  crmNote         String?
  crmNoteEditedAt DateTime?
  crmNoteEditedBy String?

  intentScore      Int?
  needsHumanReview Boolean @default(false)
  humanConfirmed   Boolean @default(false)

  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Every webhook delivery, stored before it is processed. Quo's beta
// webhooks are Standard-Webhooks signed, which means each delivery
// carries a genuinely unique `webhook-id` — so idempotency is a real
// key, with the payload hash kept as a fallback for any provider that
// does not supply one (§8).
model WebhookEvent {
  id              String  @id @default(cuid())
  provider        String  @default("quo")
  providerEventId String?
  eventType       String
  resourceId      String?
  idempotencyKey  String
  payloadHash     String
  payload         String

  signatureValid Boolean @default(false)
  status         String  @default("received") // received | processing | processed | failed | skipped
  attempts       Int     @default(0)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  lastError   String?

  @@unique([provider, idempotencyKey])
  @@index([status, receivedAt])
  @@index([eventType, receivedAt])
}

// The background worker's to-do list.
//
// The hub runs on Vercel serverless: there is no long-lived process to
// host a queue, and pulling in Redis/BullMQ for a handful of jobs a day
// would be heavier than the problem. So jobs are rows: enqueued inside
// the webhook transaction, drained immediately after the 2xx via
// waitUntil, and swept by cron as the safety net. Backoff lives in
// `runAfter`; `dedupeKey` stops the same work being queued twice.
model JobQueue {
  id        String  @id @default(cuid())
  kind      String
  payload   String  @default("{}")
  dedupeKey String? @unique

  status      String    @default("queued") // queued | running | done | failed | dead
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter])
  @@index([kind, status])
}

// CRM ⇄ Quo contact mapping. The CRM id stays authoritative; the Quo
// contact id is just a pointer we keep so we never create a duplicate
// contact over there (§16).
model QuoContactLink {
  id       String    @id @default(cuid())
  recordId String    @unique
  record   CrmRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  quoContactId String?
  // The stable id WE send to Quo as `externalId`, so a contact can be
  // re-found even if the mapping row is lost.
  externalId   String

  lastSyncedAt   DateTime?
  lastSyncStatus String? // ok | error
  lastSyncError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoContactId])
  @@index([externalId])
}

// Small key/value store for integration health the settings page reads:
// last successful webhook, last reconciliation, last backfill. Avoids a
// migration every time we want to remember one more timestamp.
model IntegrationState {
  key       String   @id
  value     String   @default("{}")
  updatedAt DateTime @updatedAt
}

// ---------------- Reminders ----------------
//
// Plain-language nudges that reach the phone through the same Discord
// webhook as the budget alerts (src/lib/notify.ts). A daily cron
// (/api/cron/send-reminders, 08:00 UTC via vercel.json) sweeps
// everything due on or before today and pushes it.
//
// Because the sweep is daily, `dueAt` is treated as a *calendar date*:
// the time-of-day component is stored but only used for display and
// ordering, never for gating delivery.
//
// Repeating reminders are not rows-per-occurrence. When one fires, the
// cron stamps `lastFiredAt` and rolls `dueAt` forward to the next
// occurrence, so a repeating reminder is always exactly one row holding
// its *next* due date. One-off reminders are marked `done` instead.
model Reminder {
  id     String  @id @default(cuid())
  title  String
  detail String?

  dueAt DateTime

  /// none | daily | weekly | monthly — see REPEATS in src/lib/reminders.ts
  repeat String @default("none")

  /// scheduled | done | cancelled. Past-due-but-unfired stays `scheduled`.
  status String @default("scheduled")

  /// low | normal | urgent — drives the Discord colour + @everyone ping.
  priority String @default("normal")

  /// Free-text grouping ("Suppliers", "Ads"…). Null = uncategorised.
  category String?

  /// Set the moment a push is delivered; also the "has fired" marker.
  lastFiredAt DateTime?
  /// How many times this reminder has pushed (repeat reminders climb).
  fireCount   Int       @default(0)

  createdBy String   @default("you") // you | claude
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ReminderEvent[]

  @@index([status, dueAt])
  @@index([dueAt])
}

// One row per delivery attempt — the audit trail behind "History".
model ReminderEvent {
  id         String   @id @default(cuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  kind       String // fired | test | snoozed | completed | cancelled
  channel    String   @default("discord") // discord | none
  delivered  Boolean  @default(false)
  detail     String? // error text when delivery failed
  createdAt  DateTime @default(now())

  @@index([reminderId, createdAt])
}
